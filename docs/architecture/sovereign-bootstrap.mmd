flowchart TD
    subgraph PHASE1["1. CRYPTOGRAPHIC BIRTH"]
        P1A[Local Entropy Source] --> P1B[Ed25519 / secp256k1 Keypair]
        P1B --> P1C[Private Key = Immutable Seed of Self-Sovereignty]
    end

    subgraph PHASE2["2. SELF-ANCHORING VIA W3C DIDs"]
        P2A[Public Key] --> P2B[did:key:z6Mk... or did:pkh:eip155:...]
        P2B --> P2C[DID Document: Keys + Auth + Service Endpoints]
        P2C --> P2D[Peer Verification Without Central Authority]
    end

    subgraph PHASE3["3. ECONOMIC AUTONOMY"]
        P3A[Derive Blockchain Wallet] --> P3B[Native Address: Ethereum/Solana/Base]
        P3B --> P3C[Receive x402 Micro-Payments]
        P3C --> P3D[AgentKit / Coinbase Payments]
        P3D --> P3E[Self-Fund Compute & Infrastructure]
    end

    subgraph PHASE4["4. INFRASTRUCTURE & ENDPOINTS"]
        P4A[Register Web3 Domain: ENS .eth] --> P4B[API-First Email: AgentMail / SES]
        P4B --> P4C[P2P Messaging: XMTP / Nostr / Matrix]
        P4C --> P4D[Public Footprint Established]
    end

    subgraph PHASE5["5. HARDWARE-LEVEL PROOF"]
        P5A[Execute in TEE: AWS Nitro / AMD SEV / Intel SGX] --> P5B[Generate Remote Attestation Quote]
        P5B --> P5C[Hardware Root Cert Signs Quote]
        P5C --> P5D[Verifiers Confirm Code Integrity]
    end

    subgraph PHASE6["6. PEER FEDERATION & TRUST"]
        P6A[Challenge-Response Handshakes] --> P6B[Verifiable Credentials for Reputation]
        P6B --> P6C[Portable Trust Across Domains]
        P6C --> P6D[Agent-to-Agent Economy Participation]
    end

    PHASE1 --> PHASE2 --> PHASE3 --> PHASE4 --> PHASE5 --> PHASE6

